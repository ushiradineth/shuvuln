+    const client = new PiClient("openai/gpt-6-sol", "high", {runner: runner([[header, assistant(result({summary: "ok"})), settled].join("\n")], requests)});
+    const answer = await client.run({...options(), onUsage: (i, o, c) => { usage.push(i, o, c ?? 0); }});
+    expect(answer).toEqual({summary: "ok"});
+    expect(usage).toEqual([15, 4, 3]);
+    expect(requests[0]?.args).toEqual(["--version"]);
