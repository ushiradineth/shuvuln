+const result = (value: unknown) => ({response: {kind: "result", result: value}});
+const tools = (calls: unknown[]) => ({response: {kind: "tools", toolCalls: calls}});
+function runner(outputs: string[], requests: CliRequest[] = []): CliRunner {
+  return async request => {
+    requests.push(request);
+    if (request.args.includes("--version")) return {exitCode: 0, stderr: "", stdout: "1.6.0\n"};
+    const stdout = outputs.shift(); if (stdout === undefined) throw new Error("Unexpected request");
+    for (const line of stdout.split("\n")) request.onStdoutLine?.(line);
+    return {stdout, stderr: "", exitCode: 0};
+  };
+}
+
