+import { z } from "zod";
+import type { ReasoningEffort } from "../harness/openai";
+import { createEnvelopeSchema, validationIssues, type CliAnswer, type Envelope } from "./cli-protocol";
+
+/** Every Pi call made for a scan: no tools, files, session, extensions, skills or extra services. */
+export const piIsolationFlags = [
+  "--mode", "json", "--no-tools", "--no-session", "--no-extensions", "--no-skills",
+  "--no-prompt-templates", "--no-themes", "--no-context-files", "--no-mcp", "--no-approve",
+] as const;
+
+/** Pi cannot constrain a reply to a schema, so the shape of the reply is stated here instead. */
+export const piRules = "Reply with exactly one JSON object: a single response envelope and nothing else. Never place two envelopes in one reply, never write an envelope for the coordinator, and never add prose or code fences.";
+
+/** OpenHack's reasoning levels are Pi's thinking levels, except that none is off. */
+export function piThinking(effort?: ReasoningEffort): string | undefined {
+  if (!effort) return undefined;
+  return effort === "none" ? "off" : effort;
+}
+
+type JsonRecord = Record<string, unknown>;
+function record(value: unknown): JsonRecord | undefined { return value !== null && typeof value === "object" && !Array.isArray(value) ? value as JsonRecord : undefined; }
+function parsed(line: string): JsonRecord | undefined {
+  if (!line.trim()) return undefined;
+  try { const item = record(JSON.parse(line)); if (!item) throw new Error(); return item; }
+  catch { throw new Error("Pi returned an invalid JSON event."); }
+}
+function numeric(value: unknown): number { return typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : 0; }
+
+/** Fails closed on the events that mean the process left the read-only source protocol. */
+export function inspectPiEvent(line: string): void {
+  const event = parsed(line); if (!event) return;
+  if (event.type === "tool_execution_start") throw new Error("Pi attempted a tool action. The scan was stopped.");
+  if (event.type === "agent_settled" && event.aborted === true) throw new Error("Pi aborted the request.");
+  if (event.type === "auto_retry_end" && event.success === false) throw new Error("Pi could not complete this request after retrying. Check the provider login in shuvuln's Pi.");
+}
+
+/** Tracks one JSON value from `start`: which brackets are open, and whether a string is open. */
+function scan(text: string, start: number): { stack: string[]; inString: boolean; end: number; malformed: boolean } {
+  const stack: string[] = [];
+  let inString = false, escaped = false, malformed = false, end = text.length;
+  for (let i = start; i < text.length; i++) {
+    const ch = text[i];
+    if (inString) {
+      if (escaped) escaped = false; else if (ch === "\\") escaped = true; else if (ch === '"') inString = false;
+      continue;
+    }
+    if (ch === '"') inString = true;
+    else if (ch === "{" || ch === "[") stack.push(ch);
+    else if (ch === "}" || ch === "]") {
+      const open = stack.pop();
+      if ((ch === "}" && open !== "{") || (ch === "]" && open !== "[")) { malformed = true; end = i; break; }
+      if (stack.length === 0) { end = i + 1; break; }
+    }
+  }
+  return { stack, inString, end, malformed };
+}
+
+/**
+ * Reads the first JSON value in a reply. A model that is not schema-constrained sometimes
+ * writes several envelopes in a row, or prose around one. The first complete value is
+ * the reply; anything after it is ignored and reported.
+ */
+function firstValue(text: string): { value: unknown; extra: boolean } | undefined {
+  const start = text.indexOf("{");
+  if (start < 0) return undefined;
+  const state = scan(text, start);
+  if (state.malformed || state.stack.length > 0 || state.inString) return undefined;
+  try { return { value: JSON.parse(text.slice(start, state.end)), extra: text.slice(state.end).includes("{") }; }
+  catch { return undefined; }
+}
+
+/** Closes a value the model left open at its very end, such as one missing final brace. */
+function completedValue(text: string): unknown {
+  const start = text.indexOf("{");
+  if (start < 0) return undefined;
+  const state = scan(text, start);
+  if (state.malformed) return undefined;
+  const closers = state.stack.reverse().map(open => open === "{" ? "}" : "]").join("");
+  try { return JSON.parse(text.slice(start) + (state.inString ? '"' : "") + closers); }
+  catch { return undefined; }
+}
+
+function readEnvelope(text: string | undefined, onNote?: (message: string) => void): unknown {
+  const raw = text ?? "";
+  try { return JSON.parse(raw); } catch { /* Not a single clean value. Read on. */ }
+  const first = firstValue(raw);
+  if (first) {
+    if (first.extra) onNote?.("Pi placed more than one envelope in one reply. The first was used; the rest were ignored.");
+    return first.value;
+  }
+  const completed = completedValue(raw);
+  if (completed !== undefined) {
+    onNote?.("Pi left its reply open at the end. The missing closing brackets were added.");
+    return completed;
+  }
+  throw new Error("Pi returned invalid scanner output; this pass is incomplete.");
+}
+
+export function parsePiAnswer<T>(output: string, taskSchema: z.ZodType<T>, onUsage?: (input: number, output: number, cached: number) => void, onNote?: (message: string) => void): CliAnswer<T> {
+  const events = output.split(/\r?\n/).filter(line => line.trim()).map(line => { inspectPiEvent(line); return parsed(line)!; });
+  let text: string | undefined, input = 0, tokens = 0, cached = 0, settled = false;
+  let stopReason: unknown, errorMessage: unknown;
+  for (const event of events) {
+    if (event.type === "agent_settled") settled = true;
+    if (event.type !== "message_end") continue;
+    const message = record(event.message);
+    if (message?.role !== "assistant") continue;
+    const blocks = Array.isArray(message.content) ? message.content.map(record) : [];
+    text = blocks.filter(block => block?.type === "text").map(block => String(block?.text ?? "")).join("");
+    stopReason = message.stopReason; errorMessage = message.errorMessage;
+    const usage = record(message.usage), cacheRead = numeric(usage?.cacheRead);
+    input = numeric(usage?.input) + cacheRead + numeric(usage?.cacheWrite); tokens = numeric(usage?.output); cached = cacheRead;
+  }
+  if (!settled) throw new Error("Pi ended without completing the request. Check the provider login in shuvuln's Pi.");
+  if (stopReason !== "stop") throw new Error(`Pi stopped with ${typeof stopReason === "string" ? stopReason : "no response"}${typeof errorMessage === "string" ? `: ${errorMessage}` : ""}.`);
+  onUsage?.(input, tokens, cached);
+  const value = readEnvelope(text, onNote);
+  const checked = createEnvelopeSchema(taskSchema).safeParse(value);
+  if (!checked.success) throw new Error(`Pi returned invalid scanner output; this pass is incomplete. ${validationIssues(checked.error.issues, taskSchema)}`);
+  const response = checked.data.response;
+  const envelope: Envelope<T> = response.kind === "tools" ? {toolCalls: response.toolCalls, result: null} : {toolCalls: [], result: response.result};
+  return {envelope, input, output: tokens, cached};
+}
