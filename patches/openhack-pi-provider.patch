+    for (const flag of ["--mode", "json", "--no-tools", "--no-session", "--no-extensions", "--no-skills", "--no-prompt-templates", "--no-themes", "--no-context-files", "--no-mcp", "--no-approve"]) expect(args).toContain(flag);
+    expect(args).not.toContain("--provider");
+    expect(requests[1]!.input).toContain("Review the supplied source.");
+  });
